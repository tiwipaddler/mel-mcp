# Copy to .env and fill in what you need: cp .env.example .env
# Everything except the API keys has a working default.

# --- API keys (both optional) -----------------------------------------------
# Claude-written summaries in drift reports
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# mel-fetch-iati (free key: https://developer.iatistandard.org)
IATI_API_KEY=

# --- Paths (relative to the project folder) ---------------------------------
DOCS_DIR=docs
MANIFEST_FILE=docs/manifest.csv
DATA_DIR=data
CHROMA_DIR=db
REPORTS_DIR=reports
AUDIT_LOG=logs/audit.jsonl

# --- Documents --------------------------------------------------------------
# Changing the embedding model means re-running mel-ingest
EMBEDDING_MODEL=sentence-transformers/multi-qa-mpnet-base-cos-v1
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
# Minimum cosine similarity (0 to 1) for a passage to be returned
SCORE_THRESHOLD=0.3

# --- Survey data --------------------------------------------------------------
# Groups with fewer respondents than this are never reported
MIN_CELL_SIZE=10
# Data queries are stopped after this many seconds
QUERY_TIMEOUT_SECONDS=10

# --- Audit log ------------------------------------------------------------------
# Name recorded with each tool call (defaults to your login name)
MEL_USER=
